pipeline {
    agent any 
    stages {
        stage('PULL') {
            steps {
                git branch: 'dev', url: 'https://github.com/shubhamkalsait/ginger-infra.git'
            }
        }
        stage('PLAN') {
            steps {
                sh '''terraform init
                    terraform plan -var-file=vars/dev.tfvars'''
            }
        }
        stage('APPROVAL'){
            steps {
                timeout(10){
                    input 'Wait for approval'
                }
            }
        }
        stage('APPLY') {
            steps {
                sh 'terraform apply -var-file=vars/dev.tfvars --auto-approve'
            }
        }
    }
}